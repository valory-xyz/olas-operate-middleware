#!/bin/bash

# Pre-push hook to run linting checks before pushing

echo "Running pre-push linting checks..."

uv sync --all-groups && uv run tox -p -e flake8 -e pylint && uv run tox -p -e black-check -e isort-check -e bandit -e mypy
RESULT=$?

# Run safety separately — non-fatal, as it has known environment
# incompatibilities (nltk vs Python 3.13 import security) that are
# unrelated to code quality.
if ! uv run tox -e safety 2>/dev/null; then
    echo "WARNING: safety check failed (non-fatal — see tox output above)"
fi

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "Pre-push linting failed. Please fix the issues above before pushing."
    exit 1
fi

echo ""
echo "Pre-push linting passed!"
exit 0
